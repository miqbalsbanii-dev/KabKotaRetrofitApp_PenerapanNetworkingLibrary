<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.DetailKabKotaActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/app_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/tvKabKota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/imgLogo"
            tools:text="Kabupaten Bengkalis" />

        <TableLayout
            android:id="@+id/tableLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:stretchColumns="1"
            app:layout_constraintTop_toBottomOf="@+id/tvKabKota">

            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:text="@string/pusat_pemerintahan"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvPusatPemerintahan"
                    android:layout_marginStart="8dp" />
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:text="@string/bupati_walikota"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvBupatiWalikota"
                    android:layout_marginStart="8dp" />
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:text="@string/luas_wilayah"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvLuasWilayah"
                    android:layout_marginStart="8dp" />
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:text="@string/jumlah_penduduk"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvJumlahPenduduk"
                    android:layout_marginStart="8dp" />
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:text="@string/jumlah_kecamatan"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvJumlahKecamatan"
                    android:layout_marginStart="8dp" />
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:text="@string/jumlah_kelurahan"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvJumlahKelurahan"
                    android:layout_marginStart="8dp" />
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:text="@string/jumlah_desa"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvJumlahDesa"
                    android:layout_marginStart="8dp" />
            </TableRow>
        </TableLayout>

        <TextView
            android:id="@+id/tvDeskripsiLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/deskripsi"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/tableLayout" />

        <TextView
            android:id="@+id/tvDeskripsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:justificationMode="inter_word"
            app:layout_constraintTop_toBottomOf="@+id/tvDeskripsiLabel"
            tools:targetApi="o" />

        <Button
            android:id="@+id/btnViewPeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/tampilkan_peta_wilayah"
            app:layout_constraintTop_toBottomOf="@+id/tvDeskripsi" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>